function Trade.parseAmount(text)
	if text == nil then return 0 end
	local t = tostring(text):match("^%s*(.-)%s*$")
	if t == "" or t == "..." or t == ".." or t == "." then return 1 end
	local n = t:match("x(%d+)")
	if n then return tonumber(n) end
	n = tonumber(t); if n then return n end
	return 1
end

